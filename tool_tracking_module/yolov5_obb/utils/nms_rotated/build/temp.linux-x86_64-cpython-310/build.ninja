cflags = -march=x86-64-v2 -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/curi/anaconda3/envs/yolov5_obb_topleft/include -I/home/curi/anaconda3/envs/yolov5_obb_topleft/targets/x86_64-linux/include -L/home/curi/anaconda3/envs/yolov5_obb_topleft/targets/x86_64-linux/lib -L/home/curi/anaconda3/envs/yolov5_obb_topleft/targets/x86_64-linux/lib/stubs -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/curi/anaconda3/envs/yolov5_obb_topleft/include -I/home/curi/anaconda3/envs/yolov5_obb_topleft/targets/x86_64-linux/include -L/home/curi/anaconda3/envs/yolov5_obb_topleft/targets/x86_64-linux/lib -L/home/curi/anaconda3/envs/yolov5_obb_topleft/targets/x86_64-linux/lib/stubs -fPIC -DWITH_CUDA -I/home/curi/anaconda3/envs/yolov5_obb_topleft/lib/python3.10/site-packages/torch/include -I/home/curi/anaconda3/envs/yolov5_obb_topleft/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/curi/anaconda3/envs/yolov5_obb_topleft/include -I/home/curi/anaconda3/envs/yolov5_obb_topleft/include/python3.10 -c
